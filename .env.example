# Konfigurasi Lingkungan Produksi Kontrakan
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
TZ=Asia/Jakarta

# Kredensial Administrator Web Dashboard
APP_USER=admin
APP_PASS=ganti_password_ini_sebelum_production

# Rahasia Kriptografis Token (Opsional, jika kosong di-generate otomatis)
# JWT_SECRET=masukkan_random_hex_32_bytes_disini

# Rahasia Webhook WhatsApp Eksternal (Opsional, jika kosong di-generate otomatis)
# WA_WEBHOOK_SECRET=masukkan_random_hex_32_bytes_disini

# Konfigurasi Reverse Proxy (1 jika di belakang Nginx/Cloudflare/Docker)
TRUST_PROXY=1

# Lokasi Data Persisten (SQLite, Upload Bukti, Backup, Sesi WhatsApp)
DATA_DIR=/app/data
